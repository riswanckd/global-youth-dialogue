# ==============================================================================
# GLOBAL YOUTH DIALOGUE & EXCHANGE (GYDE) - ENVIRONMENT CONFIGURATION
# ==============================================================================

NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1

# MongoDB Connection String (Atlas or Local)
# If empty or unreachable in development, the API falls back to an embedded in-memory MongoDB instance
MONGODB_URI=mongodb://127.0.0.1:27017/gyde

# Frontend Origins (CORS allowlist)
WEB_ORIGIN=http://localhost:5173
ADMIN_ORIGIN=http://localhost:5174

# JWT & Cookie Session Secrets
JWT_SECRET=gyde_dev_secret_key_change_in_production_min_32_chars
JWT_EXPIRES_IN=7d
COOKIE_SECRET=gyde_cookie_secret_dev_key_32_chars_minimum
CHAT_ENCRYPTION_KEY=gyde_chat_secure_encryption_key_32_bytes_min_prod!
VAPID_PUBLIC_KEY=BIv2srQhdcsepDmEN76prgkLFTSe_pjYUVHRALDoMFHMZp7ntyw-aFzpbdWl0KWbP2wk6C0x23e4eF4p_yAgcG8
VAPID_PRIVATE_KEY=DHLUuD_jGfXsT2z0TTsDhh6OfNsvFR_FPGw9uY3sm18
VAPID_SUBJECT=mailto:admin@thegyde.in

# SMTP Email Configuration (Nodemailer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=thegyde.verify@gmail.com
