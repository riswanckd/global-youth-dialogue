{
  "version": 2,
  "buildCommand": "vite build || (cd web && npm install && npm run build && cd .. && node -e \"require('fs').cpSync('web/dist', 'dist', {recursive: true})\")",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/send-otp",
      "destination": "/api/send-otp.js"
    },
    {
      "source": "/api/applications",
      "destination": "/api/applications.js"
    },
    {
      "source": "/api/:path*",
      "destination": "https://gyde-api.vercel.app/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
