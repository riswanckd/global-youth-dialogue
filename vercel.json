{
  "version": 2,
  "buildCommand": "vite build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/send-otp",
      "destination": "/api/send-otp.js"
    },
    {
      "source": "/api/applications",
      "destination": "/api/applications.js"
    },
    {
      "source": "/api/:path*",
      "destination": "https://global-youth-dialogue-api.vercel.app/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
