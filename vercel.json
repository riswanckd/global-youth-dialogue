{
  "version": 2,
  "buildCommand": "node scripts/build-all.cjs",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/send-otp",
      "destination": "/api/send-otp.js"
    },
    {
      "source": "/api/applications",
      "destination": "/api/applications.js"
    },
    {
      "source": "/api/:path*",
      "destination": "https://gyde-api.vercel.app/api/:path*"
    },
    {
      "source": "/admin/assets/:path*",
      "destination": "/admin/assets/:path*"
    },
    {
      "source": "/admin",
      "destination": "/admin/index.html"
    },
    {
      "source": "/admin/(.*)",
      "destination": "/admin/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
