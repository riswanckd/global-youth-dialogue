{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://gyde-api.vercel.app/api/:path*"
    },
    {
      "source": "/admin",
      "destination": "https://gyde-admin.vercel.app"
    },
    {
      "source": "/admin/:path*",
      "destination": "https://gyde-admin.vercel.app/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
