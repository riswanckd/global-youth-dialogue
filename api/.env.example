# ==============================================================================
# GLOBAL YOUTH DIALOGUE & EXCHANGE (GYDE) - API ENVIRONMENT EXAMPLE
# ==============================================================================

NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1

MONGODB_URI=mongodb://127.0.0.1:27017/gyde

WEB_ORIGIN=http://localhost:5173
ADMIN_ORIGIN=http://localhost:5174

JWT_SECRET=your_jwt_secret_min_32_characters_here
JWT_EXPIRES_IN=7d
COOKIE_SECRET=your_cookie_secret_min_32_characters_here
CHAT_ENCRYPTION_KEY=your_chat_encryption_key_32_bytes_min_here
VAPID_PUBLIC_KEY=your_vapid_public_key_here
VAPID_PRIVATE_KEY=your_vapid_private_key_here
VAPID_SUBJECT=mailto:admin@thegyde.in

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_smtp_username@gmail.com
SMTP_PASS=your_smtp_app_password
FROM_EMAIL=thegyde.verify@gmail.com
FROM_NAME="Global Youth Dialogue & Exchange (GYDE)"
BROADCAST_FROM_EMAIL=admin@thegyde.in
BROADCAST_REPLY_TO=admin@thegyde.in

INITIAL_ADMIN_NAME="Mubashir CP"
INITIAL_ADMIN_EMAIL=3681mubashircp@gmail.com
INITIAL_ADMIN_PASSWORD=changeMeInProduction123!
