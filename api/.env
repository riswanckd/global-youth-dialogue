NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1

# MongoDB Connection String (Atlas or Local)
# If empty or unreachable in development, the API falls back to an embedded in-memory MongoDB instance
MONGODB_URI=mongodb+srv://risilbinmusthafa_db_user:BHUP8wJFLfuMClxJ@cluster0.dxecfdk.mongodb.net/

# Frontend Origins (CORS allowlist)
WEB_ORIGIN=http://localhost:5173
ADMIN_ORIGIN=http://localhost:5174

# JWT & Cookie Session Secrets
JWT_SECRET=gyde_dev_secret_key_change_in_production_min_32_chars
JWT_EXPIRES_IN=7d
COOKIE_SECRET=gyde_cookie_secret_dev_key_32_chars_minimum

# Cloudflare Email Sending Configuration (REST API & Authenticated SMTP)
# Cloudflare Dashboard > Manage Account > API Tokens (with 'Email Sending: Edit')
CLOUDFLARE_API_TOKEN=
# Cloudflare Dashboard > Overview (Account ID displayed on right sidebar)
CLOUDFLARE_ACCOUNT_ID=
# Verified sender domain in Cloudflare Email Service (e.g. verify@thegyde.org)
CLOUDFLARE_FROM_EMAIL=

# SMTP Email Configuration (Nodemailer Fallback)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=thegyde.verify@gmail.com
SMTP_PASS=nwhnmkersbiwwrry
FROM_EMAIL=thegyde.verify@gmail.com
FROM_NAME=Global Youth Dialogue & Exchange (GYDE)

# Initial Administrator Bootstrap (used by seed script or first run)
