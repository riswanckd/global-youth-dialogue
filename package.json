{
  "name": "global-youth-dialogue",
  "version": "1.0.4",
  "description": "GYDE — Global Youth Dialogue & Exchange Monorepo Platform",
  "private": true,
  "workspaces": [
    "web",
    "admin",
    "api"
  ],
  "scripts": {
    "build": "node scripts/build-all.cjs",
    "dev": "npm --prefix web run dev",
    "dev:api": "npm --prefix api run dev",
    "dev:web": "npm --prefix web run dev",
    "dev:admin": "npm --prefix admin run dev",
    "build:api": "npm --prefix api run build",
    "build:web": "npm --prefix web run build",
    "build:admin": "npm --prefix admin run build"
  },
  "dependencies": {
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
